  function resizeImageToDataUrl(file, maxDim, cb){
    var reader = new FileReader();
    reader.onload = function(e){
      var img = new Image();
      img.onload = function(){
        var w = img.width, h = img.height;
        if (w > maxDim || h > maxDim){
          if (w >= h){ h = Math.round(h * maxDim / w); w = maxDim; }
          else { w = Math.round(w * maxDim / h); h = maxDim; }
        }
        var canvas = document.createElement('canvas');
        canvas.width = w; canvas.height = h;
        var ctx = canvas.getContext('2d');
        ctx.clearRect(0,0,w,h);
        ctx.drawImage(img, 0, 0, w, h);
        cb(canvas.toDataURL('image/png'));
      };
      img.onerror = function(){ toast("Couldn't read that image.", 'err'); };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  }

  // ---------- connect flow ----------
  function attemptConnect(fromAutoLoad){
    var token = document.getElementById('inp-token').value.trim();
    var owner = document.getElementById('inp-owner').value.trim();
    var repo = document.getElementById('inp-repo').value.trim();
    var branch = document.getElementById('inp-branch').value.trim() || 'main';
    var path = document.getElementById('inp-path').value.trim() || 'content.json';
    var remember = document.getElementById('inp-remember').checked;

    var errBox = document.getElementById('connect-error');
    errBox.className = 'error-box';

    if (!token || !owner || !repo){
      errBox.textContent = 'Please fill in your token, GitHub username and repository name.';
      errBox.className = 'error-box show';
      return;
    }

    state.token = token; state.owner = owner; state.repo = repo; state.branch = branch; state.path = path;

    showScreen('screen-loading');
    document.getElementById('loading-text').textContent = 'Connecting to GitHub…';

    apiLoad().then(function(){
      saveConnMeta();
      saveToken(token, remember);
      document.getElementById('conn-status').style.display = 'flex';
      document.getElementById('conn-status').classList.add('live');
      document.getElementById('conn-status-text').textContent = owner + '/' + repo;
      document.getElementById('btn-logout').style.display = '';
      buildEditor();
      clearDirty();
      showScreen('screen-editor');
    }).catch(function(err){
      showScreen('screen-connect');
      errBox.textContent = err.message;
      errBox.className = 'error-box show';
    });
  }

  document.getElementById('btn-connect').addEventListener('click', function(){ attemptConnect(false); });

  document.getElementById('btn-logout').addEventListener('click', function(){
    if (state.dirty && !confirm('You have unsaved changes that will be lost. Log out anyway?')) return;
    clearAll();
    state = { token:'', owner:state.owner, repo:state.repo, branch:state.branch, path:state.path, sha:null, content:null, dirty:false };
    document.getElementById('conn-status').style.display = 'none';
    document.getElementById('btn-logout').style.display = 'none';
    document.getElementById('inp-token').value = '';
    showScreen('screen-connect');
  });

  // ---------- save / discard ----------
  document.getElementById('btn-save').addEventListener('click', function(){
    var btn = document.getElementById('btn-save');
    var msg = document.getElementById('savebar-msg');
    btn.disabled = true;
    var oldHTML = btn.innerHTML;
    btn.innerHTML = '<span class="spinner"></span> Saving…';
    apiSave('Update site content via admin panel').then(function(){
      clearDirty();
      toast('Saved — your site will update in about a minute.', 'ok');
    }).catch(function(err){
      if (err.message === 'CONFLICT'){
        msg.textContent = 'This file changed on GitHub since you loaded it — reload to see the latest before saving.';
        toast('Someone/something else changed the file. Reload before saving.', 'err');
      } else {
        toast(err.message, 'err');
      }
    }).finally(function(){
      btn.disabled = false; btn.innerHTML = oldHTML;
    });
  });

  document.getElementById('btn-discard').addEventListener('click', function(){
    if (!confirm('Discard your changes and reload the last saved version?')) return;
    showScreen('screen-loading');
    document.getElementById('loading-text').textContent = 'Reloading…';
    apiLoad().then(function(){
      buildEditor();
      clearDirty();
      showScreen('screen-editor');
    }).catch(function(err){
      toast(err.message, 'err');
      showScreen('screen-editor');
    });
  });

  // ---------- init ----------
  function init(){
    var meta = loadConnMeta();
    if (meta){
      document.getElementById('inp-owner').value = meta.owner || '';
      document.getElementById('inp-repo').value = meta.repo || '';
      document.getElementById('inp-branch').value = meta.branch || 'main';
      document.getElementById('inp-path').value = meta.path || 'content.json';
    }
    var token = loadToken();
    if (token && meta && meta.owner && meta.repo){
      document.getElementById('inp-token').value = token;
      attemptConnect(true);
    } else {
      showScreen('screen-connect');
    }
  }
  init();
})();
