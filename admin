<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>THelectrics — Site Admin</title>
<meta name="robots" content="noindex, nofollow">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&family=Work+Sans:wght@400;500;600&display=swap');
  :root{
    --accent:#E8912B; --accent-hover:#cf7d1d; --bg:#f7f5f2; --panel:#ffffff; --ink:#1c1c1c;
    --muted:#6b6b6b; --line:#e7e3dd; --danger:#c0392b; --danger-bg:#fdecea; --ok:#1e7e34; --ok-bg:#e9f7ec;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    font-family:"Work Sans", -apple-system, "Segoe UI", sans-serif;
    background:var(--bg); color:var(--ink); line-height:1.5; min-height:100vh;
  }
  h1,h2,h3,.brand{font-family:"Manrope", -apple-system, "Segoe UI", sans-serif;}
  a{color:var(--accent);}
  .wrap{max-width:880px;margin:0 auto;padding:0 20px;}
  /* Top bar */
  #topbar{position:sticky;top:0;z-index:20;background:var(--panel);border-bottom:1px solid var(--line);}
  #topbar .bar{display:flex;align-items:center;gap:14px;padding:14px 20px;max-width:880px;margin:0 auto;}
  .brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:1.1rem;white-space:nowrap;}
  .brand .mark{width:28px;height:28px;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:.85rem;font-weight:800;flex-shrink:0;}
  .brand small{display:block;font-family:"Work Sans",sans-serif;font-weight:500;font-size:.72rem;color:var(--muted);}
  #topbar .spacer{flex:1;}
  #conn-status{font-size:.82rem;color:var(--muted);display:flex;align-items:center;gap:6px;}
  #conn-status .dot{width:8px;height:8px;border-radius:50%;background:#bbb;flex-shrink:0;}
  #conn-status.live .dot{background:var(--ok);}
  .btn{display:inline-flex;align-items:center;gap:8px;font-family:"Manrope",sans-serif;font-weight:700;font-size:.88rem;text-decoration:none;padding:9px 16px;border-radius:8px;border:1.5px solid transparent;cursor:pointer;white-space:nowrap;}
  .btn-solid{background:var(--accent);color:#fff;}
  .btn-solid:hover{background:var(--accent-hover);}
  .btn-solid:disabled{background:#d8b98b;cursor:not-allowed;}
  .btn-outline{background:transparent;border-color:var(--line);color:var(--ink);}
  .btn-outline:hover{border-color:var(--accent);color:var(--accent);}
  .btn-text{background:none;border:none;color:var(--muted);font-family:"Work Sans",sans-serif;font-weight:600;font-size:.85rem;cursor:pointer;padding:4px 6px;}
  .btn-text:hover{color:var(--ink);}
  .btn-sm{padding:5px 10px;font-size:.78rem;}
  .btn-danger{color:var(--danger);}
  main{padding:32px 0 100px;}
  /* Screens */
  .screen{display:none;}
  .screen.active{display:block;}
  .center-card{max-width:520px;margin:40px auto;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:32px;}
  .center-card h1{font-size:1.4rem;margin:0 0 6px;}
  .center-card .lede{color:var(--muted);font-size:.92rem;margin:0 0 24px;}
  .field{margin-bottom:16px;}
  .field label{display:block;font-weight:700;font-size:.85rem;margin-bottom:6px;font-family:"Manrope",sans-serif;}
  .field .hint{color:var(--muted);font-size:.78rem;margin-top:5px;}
  input[type=text],input[type=password],input[type=url],input[type=tel],input[type=email],textarea,select{
    width:100%;padding:10px 12px;border:1.5px solid var(--line);border-radius:8px;font-family:inherit;font-size:.92rem;background:#fff;color:var(--ink);
  }
  input:focus,textarea:focus,select:focus{outline:2px solid color-mix(in srgb, var(--accent) 45%, transparent);border-color:var(--accent);}
  textarea{resize:vertical;min-height:64px;}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .checkbox-row{display:flex;align-items:center;gap:8px;font-size:.88rem;}
  .checkbox-row input{width:auto;}
  details.help{margin-top:18px;border-top:1px solid var(--line);padding-top:14px;}
  details.help summary{cursor:pointer;font-weight:700;font-size:.85rem;color:var(--accent);}
  details.help ol{margin:12px 0 0;padding-left:20px;font-size:.85rem;color:var(--muted);}
  details.help li{margin-bottom:6px;}
  .error-box{background:var(--danger-bg);color:var(--danger);border-radius:8px;padding:12px 14px;font-size:.87rem;margin:0 0 16px;display:none;}
  .error-box.show{display:block;}
  /* Editor layout */
  #editor-title{margin:0 0 4px;font-size:1.5rem;}
  #editor-sub{color:var(--muted);font-size:.88rem;margin:0 0 24px;}
  details.section{background:var(--panel);border:1px solid var(--line);border-radius:12px;margin-bottom:16px;overflow:hidden;}
  details.section > summary{list-style:none;cursor:pointer;padding:16px 20px;font-weight:800;font-family:"Manrope",sans-serif;font-size:1rem;display:flex;align-items:center;gap:10px;}
  details.section > summary::-webkit-details-marker{display:none;}
  details.section > summary .chev{margin-left:auto;color:var(--muted);transition:transform .15s;font-size:.8rem;}
  details.section[open] > summary .chev{transform:rotate(90deg);}
  details.section > summary .tag{font-family:"Work Sans",sans-serif;font-weight:500;color:var(--muted);font-size:.78rem;}
  .section-body{padding:4px 20px 20px;border-top:1px solid var(--line);}
  .item-card{border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin:14px 0;background:#fdfcfb;}
  .item-card-head{display:flex;align-items:center;gap:10px;margin-bottom:10px;font-size:.78rem;color:var(--muted);font-weight:700;}
  .item-controls{margin-left:auto;display:flex;gap:6px;}
  .icon-btn{background:#fff;border:1.5px solid var(--line);border-radius:6px;width:30px;height:28px;cursor:pointer;font-size:.85rem;color:var(--ink);display:inline-flex;align-items:center;justify-content:center;}
  .icon-btn:hover{border-color:var(--accent);color:var(--accent);}
  .icon-btn:disabled{opacity:.35;cursor:not-allowed;}
  .icon-btn.danger:hover{border-color:var(--danger);color:var(--danger);}
  .add-row{margin-top:6px;}
  .pill-list{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;}
  .pill-edit{display:flex;align-items:center;gap:6px;background:#fdfcfb;border:1px solid var(--line);border-radius:20px;padding:4px 6px 4px 12px;}
  .pill-edit input{border:none;padding:2px 0;width:110px;background:transparent;}
  .pill-edit input:focus{outline:none;}
  .pill-edit button{background:none;border:none;color:var(--muted);cursor:pointer;font-size:.9rem;padding:2px 6px;}
  .pill-edit button:hover{color:var(--danger);}
  .color-row{display:flex;align-items:center;gap:10px;}
  .color-row input[type=color]{width:44px;height:40px;padding:2px;border-radius:8px;cursor:pointer;}
  .color-row input[type=text]{flex:1;}
  .logo-row{display:flex;align-items:center;gap:16px;}
  .logo-preview{width:64px;height:64px;border-radius:12px;background:#fdfcfb;border:1.5px dashed var(--line);display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0;}
  .logo-preview img{width:100%;height:100%;object-fit:contain;}
  .logo-preview.empty::after{content:'No logo';font-size:.68rem;color:var(--muted);text-align:center;}
  /* Save bar */
  #savebar{position:fixed;left:0;right:0;bottom:0;z-index:30;background:var(--panel);border-top:1px solid var(--line);box-shadow:0 -6px 20px rgba(0,0,0,.06);transform:translateY(100%);transition:transform .2s ease-out;}
  #savebar.show{transform:translateY(0);}
  #savebar .bar{max-width:880px;margin:0 auto;padding:14px 20px;display:flex;align-items:center;gap:14px;}
  #savebar .msg{font-size:.85rem;color:var(--muted);flex:1;}
  /* Toast */
  #toast{position:fixed;top:18px;left:50%;transform:translateX(-50%) translateY(-12px);z-index:50;background:var(--ink);color:#fff;padding:12px 20px;border-radius:9px;font-size:.88rem;font-weight:600;opacity:0;pointer-events:none;transition:opacity .2s, transform .2s;box-shadow:0 8px 24px rgba(0,0,0,.18);}
  #toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
  #toast.ok{background:var(--ok);}
  #toast.err{background:var(--danger);}
  .spinner{width:16px;height:16px;border-radius:50%;border:2.5px solid rgba(255,255,255,.4);border-top-color:#fff;animation:spin .7s linear infinite;display:inline-block;}
  .spinner.dark{border-color:rgba(0,0,0,.15);border-top-color:var(--accent);}
  @keyframes spin{to{transform:rotate(360deg);}}
  #loading-screen{display:flex;flex-direction:column;align-items:center;gap:14px;padding:80px 20px;color:var(--muted);font-size:.9rem;}
  .field-title{font-family:"Manrope",sans-serif;font-weight:800;font-size:.92rem;margin:0 0 12px;}
  @media (max-width:560px){ .row2{grid-template-columns:1fr;} #topbar .bar{flex-wrap:wrap;} }
</style>
</head>
<body>

<div id="topbar">
  <div class="bar">
    <div class="brand"><span class="mark">TH</span><span>THelectrics<br><small>Site Admin</small></span></div>
    <div class="spacer"></div>
    <span id="conn-status" style="display:none;"><span class="dot"></span><span id="conn-status-text"></span></span>
    <button id="btn-logout" class="btn-text" style="display:none;">Log out</button>
  </div>
</div>

<main class="wrap">

  <!-- CONNECT SCREEN -->
  <section id="screen-connect" class="screen">
    <div class="center-card">
      <h1>Connect to your website</h1>
      <p class="lede">Paste a GitHub access token so this admin panel can read and save your site's content. This talks directly to GitHub — nothing is stored anywhere except your own browser.</p>
      <div id="connect-error" class="error-box"></div>
      <div class="field">
        <label for="inp-token">GitHub personal access token</label>
        <input type="password" id="inp-token" autocomplete="off" placeholder="github_pat_..." />
        <p class="hint">Only needs <strong>Contents: Read and write</strong> access on this one repository. See "How do I get a token?" below.</p>
      </div>
      <div class="row2">
        <div class="field">
          <label for="inp-owner">GitHub username</label>
          <input type="text" id="inp-owner" placeholder="baotramha04-coder" />
        </div>
        <div class="field">
          <label for="inp-repo">Repository name</label>
          <input type="text" id="inp-repo" placeholder="baotramha04-coder.github.io" />
        </div>
      </div>
      <div class="row2">
        <div class="field">
          <label for="inp-branch">Branch</label>
          <input type="text" id="inp-branch" placeholder="main" value="main" />
        </div>
        <div class="field">
          <label for="inp-path">Content file path</label>
          <input type="text" id="inp-path" placeholder="content.json" value="content.json" />
        </div>
      </div>
      <div class="field">
        <label class="checkbox-row"><input type="checkbox" id="inp-remember" checked /> Remember this token on this device</label>
        <p class="hint">Leave this on for your own computer. Turn it off on a shared or public computer — you'll need to paste the token again next time.</p>
      </div>
      <button id="btn-connect" class="btn btn-solid" style="width:100%;justify-content:center;">Connect</button>

      <details class="help">
        <summary>How do I get a token?</summary>
        <ol>
          <li>Go to <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">github.com/settings/personal-access-tokens/new</a> (sign in to GitHub first).</li>
          <li>Give it a name, e.g. "THelectrics admin".</li>
          <li>Under <strong>Repository access</strong>, choose <strong>Only select repositories</strong> and pick your website's repository.</li>
          <li>Under <strong>Permissions → Repository permissions</strong>, set <strong>Contents</strong> to <strong>Read and write</strong>. Leave everything else as "No access".</li>
          <li>Click <strong>Generate token</strong>, then copy it — GitHub only shows it once.</li>
          <li>Paste it into the box above. You can revoke or regenerate it any time from that same GitHub settings page.</li>
        </ol>
      </details>
    </div>
  </section>

  <!-- LOADING SCREEN -->
  <section id="screen-loading" class="screen">
    <div id="loading-screen">
      <span class="spinner dark"></span>
      <span id="loading-text">Connecting…</span>
    </div>
  </section>

  <!-- EDITOR SCREEN -->
  <section id="screen-editor" class="screen">
    <h1 id="editor-title">Edit your site</h1>
    <p id="editor-sub">Changes here are saved straight to your website's GitHub repository. Your live site updates about a minute after you save.</p>
    <div id="editor-root"></div>
  </section>

</main>

<div id="savebar">
  <div class="bar">
    <span class="msg" id="savebar-msg">You have unsaved changes.</span>
    <button id="btn-discard" class="btn btn-outline btn-sm">Discard</button>
    <button id="btn-save" class="btn btn-solid">Save changes</button>
  </div>
</div>

<div id="toast"></div>

<script>
(function(){
  "use strict";

  var GH_API = 'https://api.github.com';
  var ICONS = ['shield-check','clock','home-map','switchboard','bulb','alarm-star','zigzag-fault','commercial-building','pricing-flow','checkmark','phone','mail','map-pin'];
  var SECTION_LABELS = { services:'Services', 'why-us':'Why Us', areas:'Service Area', faq:'FAQ', contact:'Contact' };

  var state = {
    token:'', owner:'', repo:'', branch:'main', path:'content.json',
    sha:null, content:null, dirty:false
  };

  // ---------- storage ----------
  function saveConnMeta(){
    var meta = { owner:state.owner, repo:state.repo, branch:state.branch, path:state.path };
    try{ localStorage.setItem('thelectrics_admin_conn', JSON.stringify(meta)); }catch(e){}
  }
  function loadConnMeta(){
    try{
      var raw = localStorage.getItem('thelectrics_admin_conn');
      if (raw) return JSON.parse(raw);
    }catch(e){}
    return null;
  }
  function saveToken(token, remember){
    try{
      if (remember){ localStorage.setItem('thelectrics_admin_token', token); sessionStorage.removeItem('thelectrics_admin_token'); }
      else { sessionStorage.setItem('thelectrics_admin_token', token); localStorage.removeItem('thelectrics_admin_token'); }
    }catch(e){}
  }
  function loadToken(){
    try{ return localStorage.getItem('thelectrics_admin_token') || sessionStorage.getItem('thelectrics_admin_token') || ''; }catch(e){ return ''; }
  }
  function clearAll(){
    try{
      localStorage.removeItem('thelectrics_admin_token');
      sessionStorage.removeItem('thelectrics_admin_token');
    }catch(e){}
  }

  // ---------- base64 helpers (unicode-safe) ----------
  function b64EncodeUnicode(str){
    return btoa(encodeURIComponent(str).replace(/%([0-9A-F]{2})/g, function(_, p1){ return String.fromCharCode(parseInt(p1,16)); }));
  }
  function b64DecodeUnicode(str){
    return decodeURIComponent(atob(str).split('').map(function(c){ return '%' + ('00'+c.charCodeAt(0).toString(16)).slice(-2); }).join(''));
  }

  // ---------- GitHub API ----------
  function ghHeaders(extra){
    var h = { 'Authorization':'Bearer '+state.token, 'Accept':'application/vnd.github+json', 'X-GitHub-Api-Version':'2022-11-28' };
    if (extra) for (var k in extra) h[k]=extra[k];
    return h;
  }
  function contentsUrl(){
    return GH_API+'/repos/'+encodeURIComponent(state.owner)+'/'+encodeURIComponent(state.repo)+'/contents/'+state.path.split('/').map(encodeURIComponent).join('/');
  }
  function apiLoad(){
    return fetch(contentsUrl()+'?ref='+encodeURIComponent(state.branch), { headers: ghHeaders() })
      .then(function(res){
        if (!res.ok){
          return res.json().catch(function(){ return {}; }).then(function(body){
            throw new Error(describeError(res.status, body));
          });
        }
        return res.json();
      })
      .then(function(data){
        state.sha = data.sha;
        var jsonStr = b64DecodeUnicode((data.content||'').replace(/\n/g,''));
        state.content = JSON.parse(jsonStr);
      });
  }
  function apiSave(message){
    var jsonStr = JSON.stringify(state.content, null, 2);
    return fetch(contentsUrl(), {
      method:'PUT',
      headers: ghHeaders({'Content-Type':'application/json'}),
      body: JSON.stringify({
        message: message || 'Update site content via admin panel',
        content: b64EncodeUnicode(jsonStr),
        sha: state.sha,
        branch: state.branch
      })
    }).then(function(res){
      if (!res.ok){
        return res.json().catch(function(){ return {}; }).then(function(body){
          var err = new Error(describeError(res.status, body));
          err.status = res.status;
          throw err;
        });
      }
      return res.json();
    }).then(function(data){
      state.sha = data.content.sha;
    });
  }
  function describeError(status, body){
    var msg = (body && body.message) || '';
    if (status === 401) return "That token wasn't accepted. Double-check you pasted the whole thing and that it hasn't expired.";
    if (status === 404) return "Couldn't find that repository or file. Check the username, repository name and file path.";
    if (status === 403) return "That token doesn't have permission to do this. Make sure it has Contents: Read and write access on this repository." + (msg?(' ('+msg+')'):'');
    if (status === 409) return 'CONFLICT';
    if (status === 422) return 'GitHub rejected the request — the file path or branch may be wrong. ' + msg;
    return 'Something went wrong talking to GitHub (status '+status+'). '+msg;
  }

  // ---------- small DOM helpers ----------
  function el(tag, attrs, kids){
    var e = document.createElement(tag);
    if (attrs) for (var k in attrs){
      if (k==='class') e.className = attrs[k];
      else if (k==='html') e.innerHTML = attrs[k];
      else e.setAttribute(k, attrs[k]);
    }
    (kids||[]).forEach(function(k){ if (k) e.appendChild(k); });
    return e;
  }
  function txt(t){ return document.createTextNode(t); }

  function markDirty(){
    if (state.dirty) return;
    state.dirty = true;
    document.getElementById('savebar').classList.add('show');
  }
  function clearDirty(){
    state.dirty = false;
    document.getElementById('savebar').classList.remove('show');
  }
  window.addEventListener('beforeunload', function(e){
    if (state.dirty){ e.preventDefault(); e.returnValue=''; }
  });

  function toast(msg, kind){
    var t = document.getElementById('toast');
    t.textContent = msg;
    t.className = 'show' + (kind ? ' '+kind : '');
    clearTimeout(t._h);
    t._h = setTimeout(function(){ t.className=''; }, 3600);
  }

  function showScreen(id){
    document.querySelectorAll('.screen').forEach(function(s){ s.classList.remove('active'); });
    document.getElementById(id).classList.add('active');
  }

  // ---------- field builders ----------
  function field(labelText, inputEl, hint){
    var kids = [el('label', {}, [txt(labelText)]), inputEl];
    if (hint) kids.push(el('p', {class:'hint'}, [txt(hint)]));
    return el('div', {class:'field'}, kids);
  }
  function textInput(value, onInput, opts){
    opts = opts||{};
    var inp = document.createElement(opts.textarea ? 'textarea' : 'input');
    if (!opts.textarea) inp.type = opts.type || 'text';
    inp.value = value || '';
    if (opts.placeholder) inp.placeholder = opts.placeholder;
    inp.addEventListener('input', function(){ onInput(inp.value); markDirty(); });
    return inp;
  }
  function checkboxField(labelText, checked, onChange){
    var inp = el('input', {type:'checkbox'});
    inp.checked = !!checked;
    inp.addEventListener('change', function(){ onChange(inp.checked); markDirty(); });
    return el('label', {class:'checkbox-row'}, [inp, txt(labelText)]);
  }
  function iconSelectEl(value, onChange){
    var sel = document.createElement('select');
    ICONS.forEach(function(name){
      var opt = el('option', {value:name}, [txt(name)]);
      if (name === value) opt.selected = true;
      sel.appendChild(opt);
    });
    sel.addEventListener('change', function(){ onChange(sel.value); markDirty(); });
    return sel;
  }
  function iconBtn(label, title, onClick, opts){
    opts = opts||{};
    var b = el('button', {type:'button', class:'icon-btn'+(opts.danger?' danger':''), title:title}, [txt(label)]);
    if (opts.disabled) b.disabled = true;
    b.addEventListener('click', onClick);
    return b;
  }

  // Generic reorderable list-of-objects editor.
  // arr: array reference; renderFields(card, item): populate card with field()s bound to item's props.
  // makeNew(): returns a fresh default item.
  function objectListEditor(container, arr, renderFields, makeNew, addLabel){
    function rerender(){
      container.innerHTML = '';
      arr.forEach(function(item, idx){
        var head = el('div', {class:'item-card-head'}, [
          txt('#'+(idx+1)),
          el('div', {class:'item-controls'}, [
            iconBtn('↑','Move up', function(){ if (idx>0){ arr.splice(idx-1,0,arr.splice(idx,1)[0]); markDirty(); rerender(); } }, {disabled: idx===0}),
            iconBtn('↓','Move down', function(){ if (idx<arr.length-1){ arr.splice(idx+1,0,arr.splice(idx,1)[0]); markDirty(); rerender(); } }, {disabled: idx===arr.length-1}),
            iconBtn('✕','Remove', function(){ if (confirm('Remove this item?')){ arr.splice(idx,1); markDirty(); rerender(); } }, {danger:true})
          ])
        ]);
        var card = el('div', {class:'item-card'}, [head]);
        renderFields(card, item);
        container.appendChild(card);
      });
      var addBtn = el('button', {type:'button', class:'btn btn-outline btn-sm add-row'}, [txt('+ '+(addLabel||'Add item'))]);
      addBtn.addEventListener('click', function(){ arr.push(makeNew()); markDirty(); rerender(); });
      container.appendChild(addBtn);
    }
    rerender();
    return rerender;
  }

  // Simple reorderable list of plain strings (pills).
  function stringListEditor(container, arr, addLabel){
    function rerender(){
      container.innerHTML = '';
      var wrap = el('div', {class:'pill-list'});
      arr.forEach(function(val, idx){
        var inp = document.createElement('input');
        inp.type = 'text'; inp.value = val;
        inp.addEventListener('input', function(){ arr[idx] = inp.value; markDirty(); });
        var rm = el('button', {type:'button', title:'Remove'}, [txt('✕')]);
        rm.addEventListener('click', function(){ arr.splice(idx,1); markDirty(); rerender(); });
        wrap.appendChild(el('div', {class:'pill-edit'}, [inp, rm]));
      });
      container.appendChild(wrap);
      var addBtn = el('button', {type:'button', class:'btn btn-outline btn-sm add-row'}, [txt('+ '+(addLabel||'Add'))]);
      addBtn.addEventListener('click', function(){ arr.push(''); markDirty(); rerender(); setTimeout(function(){ var inps=wrap.querySelectorAll('input'); if (inps.length) inps[inps.length-1].focus(); },0); });
      container.appendChild(addBtn);
    }
    rerender();
    return rerender;
  }

  function sectionDetails(title, tag, bodyEl){
    var summary = el('summary', {}, [txt(title), el('span',{class:'tag'},[txt(tag||'')]), el('span',{class:'chev'},[txt('▸')])]);
