              iconBtn('↓','Move down', function(){ if (idx<c.sections.length-1){ c.sections.splice(idx+1,0,c.sections.splice(idx,1)[0]); markDirty(); rerenderOrder(); } }, {disabled: idx===c.sections.length-1})
            ])
          ]),
